#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,15,0,0
PRODUCTVERSION 0,15,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "tom-tour"
      VALUE "FileDescription", "NX2 Launcher - Switch 2 emulator manager"
      VALUE "InternalName", "NX2 Launcher"
      VALUE "ProductName", "NX2 Launcher"
      VALUE "FileVersion", "0.15.0"
      VALUE "ProductVersion", "0.15.0"
      VALUE "OriginalFilename", "NX2 Launcher.exe"
      VALUE "LegalCopyright", "Copyright (C) 2026 tom-tour. GPL-3.0-or-later."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
