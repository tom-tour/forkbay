#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,7,1,0
PRODUCTVERSION 0,7,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Forkbay"
      VALUE "ProductName", "Forkbay"
      VALUE "FileVersion", "0.7.1"
      VALUE "ProductVersion", "0.7.1"
      VALUE "OriginalFilename", "Forkbay.exe"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
